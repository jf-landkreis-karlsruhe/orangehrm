#!/bin/bash
# Entrypoint of the OrangeHRM sandbox: make sure MariaDB is up, then start
# Claude Code. There is no systemd in the sandbox, so start mysqld_safe here.
set -u

db_ping() {
    mysqladmin -uroot -proot -h127.0.0.1 ping --silent > /dev/null 2>&1
}

if ! db_ping; then
    sudo mkdir -p /run/mysqld
    sudo chown mysql:mysql /run/mysqld
    sudo sh -c 'mysqld_safe --skip-syslog > /tmp/mariadb.log 2>&1 &'
    for _ in $(seq 30); do
        db_ping && break
        sleep 1
    done
    db_ping || echo "orangehrm-agent: MariaDB did not start, see /tmp/mariadb.log" >&2
fi

exec claude --dangerously-skip-permissions "$@"
