FROM node:20-bookworm

# Build arguments for user mapping
ARG UID=1000
ARG GID=1000

# Enable Corepack and install Yarn 4.1.0 globally as root (no runtime download needed)
RUN corepack enable \
    && COREPACK_ENABLE_STRICT=0 COREPACK_ENABLE_AUTO_PIN=0 CI=1 corepack prepare yarn@4.1.0 --activate \
    && corepack install -g yarn@4.1.0

# Create user with matching UID/GID from host
RUN if getent group ${GID} > /dev/null 2>&1; then \
        groupmod -n orangehrm $(getent group ${GID} | cut -d: -f1); \
    else \
        groupadd -g ${GID} orangehrm; \
    fi \
    && if getent passwd ${UID} > /dev/null 2>&1; then \
        usermod -l orangehrm -g ${GID} -m -d /home/orangehrm $(getent passwd ${UID} | cut -d: -f1); \
    else \
        useradd -u ${UID} -g orangehrm -m -s /bin/bash orangehrm; \
    fi

# Configure Yarn cache directory (inside home, owned by user)
RUN mkdir -p /home/orangehrm/.yarn-cache /home/orangehrm/.cache/node/corepack \
    && chown -R ${UID}:${GID} /home/orangehrm
ENV YARN_CACHE_FOLDER=/home/orangehrm/.yarn-cache
ENV COREPACK_HOME=/home/orangehrm/.cache/node/corepack

# Set working directory
WORKDIR /app

# Switch to non-root user
USER orangehrm

# Verify installations
RUN node --version && yarn --version
