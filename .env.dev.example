# OrangeHRM Local Development Environment Configuration
# Copy this file to .env for local development

# User ID and Group ID for container user mapping
# This ensures files created in containers have correct permissions
# Defaults to 1000 if not set
# 
# To find your UID/GID on Linux/Mac, run:
#   id -u  # for UID
#   id -g  # for GID
UID=1000
GID=1000

# Xdebug Mode
# Options: off, debug, coverage, develop, gcstats, profile, trace
# Default: off (for performance)
# Use 'coverage' for running tests with code coverage
# Use 'debug' for step debugging with IDE
XDEBUG_MODE=off
